# RapidAPI is called only by ASP.NET Core; never expose this key in the browser.
RapidApi__Key=your_rapidapi_key_here
RapidApi__Host=edb-with-gifs-and-images-by-ascendapi.p.rapidapi.com
RapidApi__SyncOnStartup=true

# ASP.NET Core API
VITE_API_URL=/api

# Dokploy / Docker Compose production settings
ASPNETCORE_ENVIRONMENT=Production
FRONTEND_URL=https://app.example.com
JWT_KEY=replace-with-a-long-random-secret
JWT_ISSUER=FitPlanner.Api
JWT_AUDIENCE=FitPlanner.Pwa
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
MYSQL_DATABASE=fitplanner
MYSQL_USER=fitplanner
MYSQL_PASSWORD=replace-with-a-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
